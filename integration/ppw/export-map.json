{
  "schemaVersion": "0.1.0",
  "sourceObjects": {
    "finding": "data/cases/*/findings.json",
    "hypothesis": "data/cases/*/hypotheses.json",
    "argumentGraph": "data/cases/*/argument-graph.json",
    "source": "data/cases/*/sources.json",
    "passage": "data/cases/*/passages.json",
    "observation": "data/cases/*/observations.json",
    "review": "data/cases/*/reviews.json"
  },
  "exportConditions": [
    "finding.status is reviewed or promoted",
    "finding.reviewStatus is human-reviewed or approved",
    "at least one accepted human review references the finding",
    "all record references resolve",
    "spiritual attribution remains explicitly qualified unless separately adjudicated"
  ],
  "targetRole": "PPW promoted claim/interpretation candidate, never automatic promotion"
}
